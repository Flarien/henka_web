---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <link rel='icon' href='/favicon.png' />

    <meta
      name='description'
      content='Henka Estudio de Sublimación y Estampado - Transformamos ideas en productos únicos y personalizados. Ubicados en Mar del Plata, ofrecemos calidad en cada pieza.'
    />
    <meta name='viewport' content='width=device-width' />

    <meta name='generator' content={Astro.generator} />
    <Analytics />
    <SpeedInsights />

    <title>{title}</title>
  </head>
  <body
    class='bg-background text-text font-sans selection:bg-primary selection:text-white select-none'
  >
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  h1,
  h2,
  h3,
  h4 {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
  }
</style>
