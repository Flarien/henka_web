---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'left' } = Astro.props;
---

<div class={align === 'center' ? 'text-center' : ''}>
  <h2
    class='font-display text-3xl md:text-4xl lg:text-5xl uppercase tracking-tight text-text'
  >
    {title}
  </h2>

  {subtitle && <p class='mt-3 max-w-lg text-xl md:text-2xl  '>{subtitle}</p>}
</div>
