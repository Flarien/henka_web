---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center px-8 py-4 uppercase tracking-[0.15em] transition-all duration-200 rounded border-b-2';

const variants = {
  primary:
    'bg-primary-container text-on-primary-container border-[#842600] hover:bg-primary-container/90 active:translate-x-[2px] active:translate-y-[2px]',

  secondary: 'border-border border text-text hover:bg-surface-variant',
};

const classes = `${baseClasses} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button class={classes}>
      <slot />
    </button>
  )
}
