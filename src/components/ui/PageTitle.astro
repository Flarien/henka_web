---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'left' } = Astro.props;
---

<div class={align === 'center' ? 'text-center' : ''}>
  <h1 class='mt-8 text-5xl md:text-7xl uppercase leading-tight font-display'>
    {title}
  </h1>

  {subtitle && <p class='mt-3 max-w-2xl '>{subtitle}</p>}
</div>
