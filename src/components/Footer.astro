---
import Container from './ui/Container.astro';
---

<footer class='border-t border-border bg-surface-lowest'>
  <Container>
    <div class='grid gap-12 py-16 lg:grid-cols-3'>
      <div>
        <h3 class='font-display text-3xl text-primary'>HENKA</h3>

        <p class='mt-4 '>
          Especialistas en sublimación textil, DTF y productos personalizados.
        </p>
      </div>

      <div>
        <h4 class='font-display uppercase mb-4'>Navegación</h4>

        <ul class='space-y-2 '>
          <li><a href='/'>Inicio</a></li>
          <li><a href='/galeria'>Galería</a></li>
          <li><a href='/productos'>Productos</a></li>
          <li><a href='/contacto'>Contacto</a></li>
        </ul>
      </div>

      <div>
        <h4 class='font-display uppercase mb-4'>Contacto</h4>

        <p>Mar del Plata, Buenos Aires</p>

        <p class='mt-2'>Atención con cita previa.</p>
      </div>
    </div>

    <div
      class='border-t border-border py-6 text-center text-sm '
    >
      © {new Date().getFullYear()} HENKA · Transformación a través del oficio.
    </div>
  </Container>
</footer>
