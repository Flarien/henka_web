---
import Container from './ui/Container.astro';

const social = {
  instagram: 'https://instagram.com/henka.estudio',
  facebook: 'https://facebook.com/henka.ar',
};
---

<footer class='border-t border-border bg-surface'>
  <Container>
    <div class='grid gap-12 py-16 md:grid-cols-3 text-center md:text-left'>
      <div>
        <h3
          class='font-display font-bold text-3xl lg:text-4xl tracking-wider text-primary'
        >
          HENKA
        </h3>

        <p class='mt-4 text-pretty lg:text-lg'>
          Especialistas en sublimación, DTF y productos personalizados.
        </p>
        <div class='flex flex-col gap-1 mt-6'>
          <div class='flex self-center md:self-start gap-4'>
            <a
              href={social.instagram}
              target='_blank'
              rel='noopener noreferrer'
              aria-label='Instagram de Henka'
              class='w-10 h-10 rounded-full border border-muted hover:border-primary flex items-center justify-center colorTransition'
            >
              <svg
                width='22'
                height='22'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='1.8'
              >
                <rect x='3' y='3' width='18' height='18' rx='5'></rect>
                <circle cx='12' cy='12' r='4'></circle>
                <circle
                  cx='17.5'
                  cy='6.5'
                  r='0.8'
                  fill='currentColor'
                  stroke='none'></circle>
              </svg>
            </a>

            <a
              href={social.facebook}
              target='_blank'
              rel='noopener noreferrer'
              aria-label='Facebook de Henka'
              class='w-10 h-10 rounded-full border border-muted hover:border-primary flex items-center justify-center colorTransition'
            >
              <svg
                width='26'
                height='26'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='1.8'
              >
                <path
                  d='M15 8h2V5h-2c-2.2 0-4 1.8-4 4v2H9v3h2v7h3v-7h2.2l.8-3H14V9c0-.6.4-1 1-1z'
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div>
        <h4
          class='tracking-wider font-display uppercase lg:text-lg font-semibold mb-4'
        >
          Navegación
        </h4>

        <ul class='space-y-3 lg:space-y-4'>
          <li>
            <a href='/' class='colorTransition'>Inicio</a>
          </li>
          <li>
            <a href='/galeria' class='colorTransition'>Galería</a>
          </li>
          <li>
            <a href='/productos' class='colorTransition'>Productos</a>
          </li>
          <li>
            <a href='/contacto' class='colorTransition'>Contacto</a>
          </li>
        </ul>
      </div>

      <div>
        <h4
          class='tracking-wider font-display uppercase lg:text-lg font-semibold mb-4'
        >
          Contacto
        </h4>

        <p>Mar del Plata, Buenos Aires</p>
        <p class='mt-2'>
          Whatsapp:
          <a
            href='https://wa.me/5492235710168'
            target='_blank'
            rel='noopener noreferrer'
            class='ml-1.5 colorTransition'
          >
            + 54 223 571 0168
          </a>
        </p>
        <p class='mt-2'>
          email:
          <a
            href='mailto:henka@gmail.com'
            target='_blank'
            rel='noopener noreferrer'
            class='ml-1.5 colorTransition'
          >
            henka@gmail.com
          </a><!-- No tengo este email jaja-->
        </p>
        <!-- Redes sociales -->
      </div>
    </div>

    <div class='border-t border-border py-6 text-center text-sm'>
      © {new Date().getFullYear()} HENKA · Todos los derechos reservados.
    </div>
  </Container>
</footer>
