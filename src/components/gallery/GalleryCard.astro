---
import Badge from "../ui/Badge.astro";

const { item } = Astro.props;
---

<a href={`/galeria/${item.slug}`}>
  <article
    class='group overflow-hidden border border-border bg-surface rounded-henka'
  >
    <div class='overflow-hidden'>
      <img
        src={item.image}
        alt={item.title}
        class='aspect-4/5
                    w-full
                    object-cover
                    transition-transform
                    duration-500
                    group-hover:scale-105'
      />
    </div>

    <div class='p-6'>
      {item.badge && <Badge>{item.badge}</Badge>}

      <h3 class='mt-4 font-display text-2xl uppercase'>
        {item.title}
      </h3>

      <p class='mt-2 text-muted'>
        {item.collectionLabel}
      </p>

      <p class='mt-5 text-sm text-muted'>
        {item.material} 
        {' · '} 
        {item.technique}
      </p>
    </div>
  </article>
</a>
