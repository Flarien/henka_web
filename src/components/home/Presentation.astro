---
import Container from '../ui/Container.astro';
import Paragraph from '../ui/Paragraph.astro';
import Section from '../ui/Section.astro';
import SectionTitle from '../ui/SectionTitle.astro';
---

<Section>
  <Container>
    <div
      class='bg-primary-dark/10 rounded-2xl p-6 md:p-8 flex flex-col md:flex-row flex-wrap gap-6 md:gap-12 items-center justify-between'
    >
      <div class='flex-1'>
        <SectionTitle
          class='text-2xl md:text-3xl lg:text-4xl'
          title='Diseño, impresión y personalización'
        />
        <div class='mt-4 h-0.5 w-24 bg-primary'></div>
        <Paragraph >
          Trabajamos con sublimación, DTF y otras técnicas de impresión para
          crear piezas duraderas, <span class='text-primary font-semibold'
            >cuidando cada detalle</span
          > desde el diseño hasta la entrega.
        </Paragraph>
      </div>

      <div
        class='border-primary border-2 w-52 lg:w-60 h-auto overflow-hidden shrink-0'
      >
        <img
          src='/images/espalda-henka.jpg'
          alt='Mujer trabajando de espaldas con una remera negra HENKA estampada, sublimando una pieza en un taller'
          class='w-full h-full grayscale object-cover'
        />
      </div>
    </div>
  </Container>
</Section>
