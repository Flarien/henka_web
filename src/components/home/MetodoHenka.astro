---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

const steps = [
  {
    number: '01',
    title: 'Consulta',
    description:
      'Analizamos tu idea, seleccionamos materiales y definimos la mejor técnica.',
  },
  {
    number: '02',
    title: 'Diseño',
    description:
      'Digitalización y prototipado. Ajustamos escalas y colores para la pieza elegida.',
  },
  {
    number: '03',
    title: 'Producción',
    description:
      'Ejecución manual y técnica en nuestro taller. Control de calidad riguroso.',
  },
];
---

<Section class='border-t border-border'>
  <Container>
    <div class='mb-16 text-center'>
      <span class='font-sans text-xs uppercase tracking-[0.2em] text-primary'
        >Workflow</span
      >
      <h2 class='mt-2 font-display text-3xl md:text-4xl uppercase text-text'>
        El método HENKA
      </h2>
    </div>

    <div class='relative flex flex-col gap-12 md:flex-row md:justify-between'>
      <div
        class='absolute left-0 top-8 hidden h-px w-full bg-border md:block -z-10'
      >
      </div>

      {
        steps.map((step) => (
          <div class='flex flex-1 flex-col items-center text-center'>
            <div class='mb-6 flex h-16 w-16 items-center justify-center border border-primary bg-background font-display text-2xl text-primary'>
              {step.number}
            </div>
            <h3 class='mb-3 font-display text-lg uppercase text-text'>
              {step.title}
            </h3>
            <p class='max-w-[250px] text-muted'>{step.description}</p>
          </div>
        ))
      }
    </div>
  </Container>
</Section>
