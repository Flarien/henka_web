---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';

const materiales = [
  { label: 'Indumentaria', icon: 'indumentaria' },
  { label: 'Textiles', icon: 'textiles' },
  { label: 'Tazas y vasos', icon: 'cup' },
  { label: 'Mates', icon: 'mate' },
  { label: 'Toallas', icon: 'toallas' },
  { label: 'Bolsas', icon: 'bolsas' },
] as const;
---

<Section class='border-t border-border'>
  <Container>
    <div
      class='mb-16 flex flex-col justify-between gap-4 md:flex-row md:items-end'
    >
      <div>
        <span class='font-sans text-xs uppercase tracking-[0.2em] text-primary'
          >Catálogo</span
        >
        <h2 class='mt-2 font-display text-3xl md:text-4xl uppercase text-text'>
          Con qué trabajamos
        </h2>
      </div>
      <p class='max-w-md text-muted md:text-right'>
        Materiales seleccionados por su durabilidad y calidad de estampado.
      </p>
    </div>

    <div
      class='grid grid-cols-2 gap-px border border-border bg-border md:grid-cols-3 lg:grid-cols-6'
    >
      {
        materiales.map((item) => (
          <div class='flex flex-col items-center gap-4 bg-background p-8 transition-colors hover:bg-surface'>
            <Icon name={item.icon} class='h-8 w-8 text-primary' />
            <span class='font-display text-sm uppercase text-text'>
              {item.label}
            </span>
          </div>
        ))
      }
    </div>
  </Container>
</Section>
